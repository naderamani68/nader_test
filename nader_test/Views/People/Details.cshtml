@model Person
@{
    ViewData["Title"] = "مشاهده اطلاعات";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">فهرست افراد</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>👤 اطلاعات فرد</span>
                <span class="badge text-bg-light fa-num">شناسه: @Model.Id</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">نام و نام خانوادگی</dt>
                    <dd class="col-sm-9 fw-bold">@Model.FullName</dd>

                    <dt class="col-sm-3">نام</dt>
                    <dd class="col-sm-9">@Model.FirstName</dd>

                    <dt class="col-sm-3">نام خانوادگی</dt>
                    <dd class="col-sm-9">@Model.LastName</dd>

                    <dt class="col-sm-3">کد ملی</dt>
                    <dd class="col-sm-9 fa-num">@Model.NationalCode</dd>

                    <dt class="col-sm-3">شماره تماس</dt>
                    <dd class="col-sm-9 fa-num">@Model.PhoneNumber</dd>

                    <dt class="col-sm-3">تاریخ ثبت</dt>
                    <dd class="col-sm-9 fa-num">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</dd>

                    <dt class="col-sm-3">آخرین ویرایش</dt>
                    <dd class="col-sm-9 fa-num">
                        @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm") : "—")
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex gap-2">
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">✏️ ویرایش</a>
                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">🗑 حذف</a>
                <a class="btn btn-outline-secondary" asp-action="Index">بازگشت به فهرست</a>
            </div>
        </div>
    </div>
</div>
