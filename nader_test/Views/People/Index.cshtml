@model PersonListViewModel
@{
    ViewData["Title"] = "فهرست افراد";

    string Fa(long number) => number.ToString()
        .Replace('0', '۰').Replace('1', '۱').Replace('2', '۲').Replace('3', '۳').Replace('4', '۴')
        .Replace('5', '۵').Replace('6', '۶').Replace('7', '۷').Replace('8', '۸').Replace('9', '۹');

    string PageUrl(int page) =>
        Url.Action("Index", new { search = Model.Search, sort = Model.Sort, page }) ?? "#";

    var startRow = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var endRow = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">فهرست افراد</h1>
        <p class="text-muted mb-0 small">
            @if (Model.TotalCount == 0)
            {
                <span>هیچ فردی ثبت نشده است.</span>
            }
            else
            {
                <span>نمایش @Fa(startRow) تا @Fa(endRow) از @Fa(Model.TotalCount) نفر</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Reports" asp-action="Index">
            📊 گزارش‌ها
        </a>
        <a class="btn btn-primary" asp-action="Create">➕ ثبت فرد جدید</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label" for="search">جستجو</label>
                <input type="text" class="form-control" id="search" name="search"
                       value="@Model.Search" placeholder="نام، نام خانوادگی، کد ملی یا شماره تماس..." />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="sort">مرتب‌سازی</label>
                <select class="form-select" id="sort" name="sort">
                    @if (string.IsNullOrEmpty(Model.Sort))
                    {
                        <option value="" selected>نام خانوادگی (الف تا ی)</option>
                    }
                    else
                    {
                        <option value="">نام خانوادگی (الف تا ی)</option>
                    }
                    @if (Model.Sort == "name_desc")
                    {
                        <option value="name_desc" selected>نام خانوادگی (ی تا الف)</option>
                    }
                    else
                    {
                        <option value="name_desc">نام خانوادگی (ی تا الف)</option>
                    }
                    @if (Model.Sort == "date")
                    {
                        <option value="date" selected>جدیدترین ثبت‌ها</option>
                    }
                    else
                    {
                        <option value="date">جدیدترین ثبت‌ها</option>
                    }
                    @if (Model.Sort == "date_asc")
                    {
                        <option value="date_asc" selected>قدیمی‌ترین ثبت‌ها</option>
                    }
                    else
                    {
                        <option value="date_asc">قدیمی‌ترین ثبت‌ها</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">جستجو</button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">پاک کردن</a>
                }
            </div>
        </form>
        <p class="text-muted small mb-0 mt-2">
            نکته: انتخاب «مرتب‌سازی» به‌تنهایی کافی نیست؛ دکمه‌ی «جستجو» را بزنید تا اعمال شود.
        </p>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>نتایج</span>
        <span class="badge text-bg-secondary fa-num">@Fa(Model.TotalCount) نفر</span>
    </div>

    @if (Model.People.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🔍</div>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <p class="mb-2">برای «@Model.Search» نتیجه‌ای پیدا نشد.</p>
                <a asp-action="Index" class="btn btn-sm btn-outline-primary">نمایش همه‌ی افراد</a>
            }
            else
            {
                <p class="mb-2">هنوز هیچ فردی ثبت نشده است.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">ثبت اولین فرد</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:60px">ردیف</th>
                        <th>نام</th>
                        <th>نام خانوادگی</th>
                        <th>کد ملی</th>
                        <th>شماره تماس</th>
                        <th>تاریخ ثبت</th>
                        <th style="width:230px">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rowNumber = startRow; }
                    @foreach (var person in Model.People)
                    {
                        <tr>
                            <td class="text-muted fa-num">@Fa(rowNumber++)</td>
                            <td>@person.FirstName</td>
                            <td class="fw-semibold">@person.LastName</td>
                            <td class="fa-num">@person.NationalCode</td>
                            <td class="fa-num">@person.PhoneNumber</td>
                            <td class="fa-num small text-muted">@person.CreatedAt.ToString("yyyy/MM/dd")</td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@person.Id">مشاهده</a>
                                    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@person.Id">ویرایش</a>
                                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@person.Id">حذف</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white">
                <nav aria-label="صفحه‌بندی">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            <a class="page-link" href="@PageUrl(Model.Page - 1)">قبلی</a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link fa-num" href="@PageUrl(i)">@Fa(i)</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link" href="@PageUrl(Model.Page + 1)">بعدی</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>
